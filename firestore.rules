rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidDeletedApkRecord(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'sha256',
          'fileName',
          'normalizedName',
          'fileSize',
          'packageHint',
          'deletionMethod',
          'riskLevel',
          'deletedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'sha256',
          'fileName',
          'normalizedName',
          'fileSize',
          'packageHint',
          'deletionMethod',
          'riskLevel',
          'deletedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.sha256 is string
        && data.sha256.size() == 64
        && data.sha256.matches('^[a-f0-9]{64}$')
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.normalizedName is string
        && data.normalizedName.size() >= 1
        && data.normalizedName.size() <= 255
        && data.fileSize is int
        && data.fileSize >= 0
        && data.packageHint is string
        && data.packageHint.size() <= 200
        && data.deletionMethod in ['disk_removed', 'suppressed_permanently', 'manual_confirmed']
        && data.riskLevel in ['critical', 'high', 'medium', 'low']
        && data.deletedAt == request.time;
    }

    function isValidHardeningStepState(data, userId, stepId) {
      return data.keys().hasAll(['ownerId', 'stepKey', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'stepKey', 'completed', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.stepKey is string
        && data.stepKey == stepId
        && data.stepKey.size() >= 1
        && data.stepKey.size() <= 80
        && data.stepKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.completed is bool
        && data.updatedAt == request.time;
    }

    function isValidThreatAnalysisRecord(data, userId) {
      return data.keys().hasAll(['ownerId', 'fileName', 'verdict', 'summary', 'analyzedAt'])
        && data.keys().hasOnly(['ownerId', 'fileName', 'verdict', 'summary', 'analyzedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.verdict in ['safe', 'suspicious', 'critical']
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 1500
        && data.analyzedAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /deleted_apks/{apkRecordId} {
        allow get: if isVerifiedOwner(userId) && isValidId(apkRecordId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(apkRecordId)
          && isValidDeletedApkRecord(incoming(), userId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId)
          && isValidId(apkRecordId)
          && existing().ownerId == request.auth.uid;
      }

      match /hardening_state/{stepId} {
        allow get: if isVerifiedOwner(userId) && isValidId(stepId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(stepId)
          && isValidHardeningStepState(incoming(), userId, stepId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(stepId)
          && isValidHardeningStepState(incoming(), userId, stepId)
          && incoming().ownerId == existing().ownerId
          && incoming().stepKey == existing().stepKey
          && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']);
        allow delete: if isVerifiedOwner(userId)
          && isValidId(stepId)
          && existing().ownerId == request.auth.uid;
      }

      match /threat_analyses/{analysisId} {
        allow get: if isVerifiedOwner(userId) && isValidId(analysisId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(analysisId)
          && isValidThreatAnalysisRecord(incoming(), userId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId)
          && isValidId(analysisId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
